# Required: a free Gemini API key — no credit card needed.
# Get one at https://aistudio.google.com/apikey (sign in with any Google account).
GEMINI_API_KEY=

# Optional: enables the web_search tool (https://tavily.com — also has a free tier)
# Leave blank and the agent will skip web search and rely on calculator/notes only.
TAVILY_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
MAX_ITERATIONS=8
